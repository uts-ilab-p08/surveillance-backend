# --- Database (Supabase Postgres, or local docker-compose postgres for dev) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/surveillance

# --- Auth ---
# Comma-separated username:password pairs are NOT used; users live in the DB.
# This secret is reserved for the future JWT upgrade path (unused by Basic Auth).
SECRET_KEY=change-me-in-production

# --- Storage ---
# Local dev: a folder on disk. Prod: point this at Supabase Storage (or S3-compatible) instead.
VIDEO_STORAGE_BACKEND=local
VIDEO_STORAGE_PATH=./data/videos

# --- LLM (abstracted — see app/services/llm.py) ---
# "mock" works with no API key so the backend runs end-to-end before a model is chosen.
LLM_PROVIDER=mock
OPENAI_API_KEY=

# --- App ---
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
