# --- Database (shared Supabase Postgres project) ---
# Split into separate fields rather than one DATABASE_URL string, since a
# Supabase password can contain characters (like "@") that break a
# hand-assembled connection string. See app/core/config.py.
#
# This backend's tables live in the "app" schema of the shared project
# (see app/db/base.py) — separate from the annotation team's "bronze"
# schema in the same project.
#
# Local docker-compose Postgres (no "app" schema needed there — Alembic
# creates it on first migrate):
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=surveillance
#
# Shared Supabase project — pooler connection details from the Supabase
# dashboard (Project Settings -> Database), e.g.:
# DB_USER=postgres.<project-ref>
# DB_PASSWORD=<the actual password>
# DB_HOST=aws-0-<region>.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres

# --- Auth ---
# Identity is entirely Supabase Auth's (GoTrue) — the frontend logs users
# in directly against Supabase, and this backend just verifies the JWT it
# issues on every request (see app/api/deps.py). No local users table, no
# /auth/login route here.
#
# This project's Supabase Auth uses asymmetric JWT Signing Keys (ES256),
# so verification uses Supabase's public JWKS endpoint, not a secret you
# have to be handed. Set this to the project's base URL (Supabase
# dashboard -> Project Settings -> General -> Project URL), e.g.
# https://<project-ref>.supabase.co — leave unset to use the local-dev
# fallback below instead.
SUPABASE_URL=

# LOCAL DEV ONLY. Used only when SUPABASE_URL above is unset, so you can
# test authenticated endpoints with scripts/make_test_jwt.py before you
# have real Supabase project access. Unrelated to anything in the real
# Supabase project — never used once SUPABASE_URL is set.
LOCAL_DEV_JWT_SECRET=change-me-for-local-dev-only

# --- RAG service (separate repo) ---
# Leave unset to run standalone — GET /search returns a canned mock answer.
# Once set, the whole product's search path runs through here: user query
# -> this backend -> RAG -> top-K videos with confidence scores -> frontend.
RAG_SERVICE_URL=

# --- App ---
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
