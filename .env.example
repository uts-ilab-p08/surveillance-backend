# --- Database (shared Supabase Postgres project) ---
# Split into separate fields rather than one DATABASE_URL string, since a
# Supabase password can contain characters (like "@") that break a
# hand-assembled connection string. See app/core/config.py.
#
# This backend's tables live in the "app" schema of the shared project
# (see app/db/base.py) — separate from the annotation team's "bronze"
# schema in the same project.
#
# Local docker-compose Postgres (no "app" schema needed there — Alembic
# creates it on first migrate):
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=surveillance
#
# Shared Supabase project — pooler connection details from the Supabase
# dashboard (Project Settings -> Database), e.g.:
# DB_USER=postgres.<project-ref>
# DB_PASSWORD=<the actual password>
# DB_HOST=aws-0-<region>.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres

# --- Auth ---
# Reserved for the future JWT upgrade path (unused by Basic Auth).
SECRET_KEY=change-me-in-production

# --- RAG service (separate repo) ---
# Leave unset to run standalone — GET /search returns a canned mock answer.
# Once set, the whole product's search path runs through here: user query
# -> this backend -> RAG -> top-K videos with confidence scores -> frontend.
RAG_SERVICE_URL=

# --- App ---
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
